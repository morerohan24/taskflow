# Server Configuration
PORT=5000
NODE_ENV=development

# Security: Mandatory Cryptographic JWT Secret (Minimum 32 characters required)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_minimum_32_character_cryptographically_secure_jwt_secret_key_here

# Security: Explicit Frontend Origins Allowlist (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Database: Supabase Credentials (Optional: if empty, backend uses built-in zero-config storage)
SUPABASE_URL=
SUPABASE_KEY=

# AI Engine: Google Gemini API Key (Optional: if empty, backend uses built-in smart NLP heuristic engine)
GEMINI_API_KEY=
